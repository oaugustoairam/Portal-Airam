# Site (copie para .env). Sem estas variáveis o portal roda em modo demonstração.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Segredos do SERVIDOR. NÃO vão no .env do site: cadastre no Supabase em
# Edge Functions > Secrets (ou: supabase secrets set NOME=valor)
#
# ZAPSIGN_API_TOKEN=        token da API (ZapSign > Configurações > Integrações > API)
# ZAPSIGN_API_URL=https://sandbox.api.zapsign.com.br   (produção: https://api.zapsign.com.br)
# ZAPSIGN_WEBHOOK_SECRET=   uma senha longa que você inventa; vai também no header do webhook
# ZAPSIGN_LOJA_NOME=        (opcional) representante da Airam que assina junto
# ZAPSIGN_LOJA_EMAIL=       (opcional) e-mail desse representante
# ZAPSIGN_LOGO_URL=         (opcional) URL pública do logo para a tela do ZapSign
# PORTAL_URL=https://portal.airam.arq.br
# RESEND_API_KEY=           e-mail (senha provisória e avisos de etapa)
# WHATSAPP_TOKEN=           token permanente da API oficial do WhatsApp (Meta)
# WHATSAPP_PHONE_NUMBER_ID= ID do número na Meta
# WHATSAPP_TEMPLATE=atualizacao_processo
# NOTIFICACOES_SECRET=      senha longa inventada; usada pelo agendador (veja AVISOS.md)
# EMAIL_REMETENTE=Airam <portal@airam.arq.br>
